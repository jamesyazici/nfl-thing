# Copy to supabase/functions/.env for local `supabase functions serve`.
# In production, set these with `supabase secrets set` (see README) — never
# commit a real .env file (it's gitignored).

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_XXXXXXXXXXXXXXXXXXXX

ALLOWED_ORIGIN=https://YOUR_GITHUB_USERNAME.github.io

PREDICTION_MARKET_PROVIDER=auto

KALSHI_API_BASE=https://external-api.kalshi.com/trade-api/v2
POLYMARKET_GAMMA_API_BASE=https://gamma-api.polymarket.com

NFLVERSE_SCHEDULE_URL=https://github.com/nflverse/nflverse-data/releases/download/schedules/games.csv

CRON_SECRET=replace-with-a-long-random-string
